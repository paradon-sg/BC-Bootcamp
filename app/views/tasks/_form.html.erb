<%= form_with model: [ project, task ], class: "mt-5 space-y-5" do |form| %>
  <div class="form-group">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-input", placeholder: "Task title" %>
    <% task.errors.full_messages_for(:title).each do |message| %>
      <p class="form-error"><%= message %></p>
    <% end %>
  </div>

  <div class="form-group">
    <%= form.label :status, class: "form-label" %>
    <%= form.select :status, Task.statuses.keys.map { |key| [key.humanize, key] }, { prompt: "Select Status" }, { class: "form-select" } %>
    <% task.errors.full_messages_for(:status).each do |message| %>
      <p class="form-error"><%= message %></p>
    <% end %>
  </div>

  <div class="form-actions">
    <button type="button" data-action="dialog#close" class="btn btn-secondary">Cancel</button>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
