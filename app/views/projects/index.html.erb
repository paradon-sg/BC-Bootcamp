<% content_for :title, "Projects" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="page-title">Projects</h1>
    <%= link_to "New project", new_project_path, class: "btn btn-primary block" %>
  </div>

  <div id="projects" class="min-w-full divide-y divide-gray-200 space-y-5">
    
    <% if @projects.any? %>
      <% @projects.each do |project| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render project %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Edit", edit_project_path(project), class: "btn btn-secondary w-full sm:w-auto" %>
            <%= button_to "Destroy", project, method: :delete, class: "btn btn-danger w-full sm:w-auto", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="empty-state">No projects found.</p>
    <% end %>
    
  </div>
</div>
