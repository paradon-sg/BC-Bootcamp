<% content_for :title, "Projects" %>

<div class="w-full space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold text-gray-900">Projects</h1>
    <%= link_to "New project", new_project_path, class: "btn btn-primary" %>
  </div>

  <%= turbo_stream_from "project-container" %>

  <div id="project-list" class="min-w-full divide-y divide-gray-200">
    <% @projects.each do |project| %>
      <%= render "projects/project", project: project %>
    <% end %>

    <p class="hidden only:block py-10 text-center text-gray-500">No projects found.</p>
  </div>
</div>
