<div id="<%= dom_id project %>" class="flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <span class="form-label">Name</span>
    <span class="text-gray-900"><%= project.name %></span>
  </div>
  <div class="flex flex-col gap-2 sm:flex-row">
    <%= link_to "Edit", edit_project_path(project), class: "btn btn-secondary" %>
    <%= button_to "Destroy", project, method: :delete, class: "btn btn-danger w-full", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
